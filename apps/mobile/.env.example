# Orbit API base URL, including the /api suffix.
# A phone cannot reach your laptop's localhost, so use the machine's LAN IP
# during development, or your deployed URL.
#   EXPO_PUBLIC_API_URL=http://192.168.1.10:5000/api
#   EXPO_PUBLIC_API_URL=https://orbit-api.onrender.com/api
# This is only the default: it can also be changed inside the app.
EXPO_PUBLIC_API_URL=http://localhost:5000/api
