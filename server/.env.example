# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT secrets - generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:3000

# Optional. Without it the API still runs: rate limiting falls back to
# per-process memory and Socket.IO runs unclustered.
# REDIS_URL=redis://localhost:6379

# How long a device may stay silent before it is marked offline
DEVICE_OFFLINE_AFTER_MINUTES=15

# Battery percentage that triggers a LOW_BATTERY alert
LOW_BATTERY_THRESHOLD=20

# Location history is personal data and expires automatically
LOCATION_HISTORY_DAYS=90

# Maximum number of queued fixes one offline-sync request may carry
LOCATION_BATCH_MAX=200

# Ceiling on how long a public share link may last
SHARE_MAX_TTL_HOURS=72

# Routing provider for the directions endpoint. Defaults to OSRM's public demo
# server, which needs no API key but is explicitly not for production traffic -
# point this at a self-hosted OSRM before relying on it.
# ROUTING_URL=https://router.project-osrm.org
